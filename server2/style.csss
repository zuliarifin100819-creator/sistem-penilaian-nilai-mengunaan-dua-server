/* ====== MODERN STYLING - SERVER 2 ====== */
* {
    box-sizing: border-box;
    transition: all 0.2s ease-in-out;
}

body {
    margin: 0;
    font-family: 'Inter', system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;
    background: #f8fafc;
    color: #334155;
    line-height: 1.5;
}

.wrap {
    max-width: 1050px;
    margin: 0 auto;
    padding: 0 20px;
}

/* Header */
header {
    background: linear-gradient(135deg, #7c3aed 0%, #6d28d9 100%);
    color: #fff;
    padding: 18px 0;
    box-shadow: 0 4px 6px -1px rgba(124, 58, 237, 0.1), 0 2px 4px -1px rgba(124, 58, 237, 0.06);
}

header .wrap {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
}

header h1 {
    margin: 0;
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.025em;
}

header small {
    font-weight: 400;
    opacity: 0.85;
    font-size: 14px;
    background: rgba(255, 255, 255, 0.15);
    padding: 2px 8px;
    border-radius: 6px;
    margin-left: 8px;
}

nav a {
    color: #fff;
    text-decoration: none;
    margin-left: 20px;
    font-size: 14px;
    font-weight: 500;
    opacity: 0.9;
}

nav a:hover {
    opacity: 1;
    text-decoration: underline;
}

/* Main & Footer */
main {
    padding-top: 32px;
    padding-bottom: 32px;
    min-height: calc(100vh - 140px);
}

footer {
    color: #94a3b8;
    font-size: 13px;
    padding: 24px 16px;
    text-align: center;
    border-top: 1px solid #e2e8f0;
}

/* Toolbar & Search */
.toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-bottom: 20px;
    flex-wrap: wrap;
}

.search {
    display: flex;
    gap: 8px;
}

input[type="text"],
input[type="number"] {
    padding: 10px 14px;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    font-size: 14px;
    background: #fff;
    color: #1e293b;
    outline: none;
    box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
}

input:focus {
    border-color: #7c3aed;
    box-shadow: 0 0 0 3px rgba(124, 58, 237, 0.15);
}

/* Buttons */
button, .btn {
    padding: 10px 16px;
    border: 0;
    border-radius: 8px;
    background: #64748b;
    color: #fff;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
}

button:hover, .btn:hover {
    opacity: 0.9;
    transform: translateY(-1px);
}

.btn-green {
    background: #16a34a;
}

.btn-green:hover {
    background: #15803d;
}

.btn-red {
    background: #dc2626;
}

/* Table Styling */
table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    background: #fff;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
    border: 1px solid #e2e8f0;
}

th, td {
    padding: 14px 16px;
    text-align: left;
    border-bottom: 1px solid #f1f5f9;
    font-size: 14px;
}

th {
    background: #f8fafc;
    color: #475569;
    font-weight: 600;
    text-transform: uppercase;
    font-size: 12px;
    letter-spacing: 0.05em;
}

tr:last-child td {
    border-bottom: none;
}

tr:hover td {
    background: #f8fafc;
}

.empty {
    text-align: center;
    color: #94a3b8;
    padding: 36px;
    font-style: italic;
}

/* Card Form */
.card {
    background: #fff;
    padding: 28px;
    border-radius: 12px;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
    border: 1px solid #e2e8f0;
    display: grid;
    gap: 18px;
    max-width: 520px;
}

.card label {
    display: grid;
    gap: 6px;
    font-size: 14px;
    font-weight: 600;
    color: #334155;
}

.card input {
    width: 100%;
    font-weight: 400;
}

/* Alerts */
.alert {
    padding: 12px 16px;
    border-radius: 8px;
    margin-bottom: 20px;
    font-size: 14px;
    font-weight: 500;
    display: flex;
    align-items: center;
}

.alert.ok {
    background: #dcfce7;
    color: #166534;
    border: 1px solid #bbf7d0;
}

.alert.error {
    background: #fee2e2;
    color: #991b1b;
    border: 1px solid #fecaca;
}

.info {
    font-size: 13px;
    color: #64748b;
    align-self: center;
    background: #f1f5f9;
    padding: 6px 12px;
    border-radius: 6px;
}

/* Status Badges */
.badge {
    padding: 4px 10px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
    display: inline-block;
    letter-spacing: 0.02em;
}

.badge.lulus {
    background: #dcfce7;
    color: #166534;
}

.badge.gagal {
    background: #fee2e2;
    color: #991b1b;
}

.badge.belum {
    background: #f1f5f9;
    color: #64748b;
}

/* Heading tambahan di halaman input */
h2 {
    font-size: 20px;
    font-weight: 700;
    color: #1e293b;
    margin-top: 0;
    margin-bottom: 16px;
}